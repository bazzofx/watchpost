# /etc/watchpost-agent/agent.env: settings and the ingest token for the watchpost-agent
# service. Installed once by deploy/agent/install-agent.sh (root:watchpost-agent, mode 0640)
# and never overwritten afterwards. Edit it, then: sudo systemctl restart watchpost-agent
#
# This file holds a secret. Keep it root:watchpost-agent 0640 and never commit it.

# The Watchpost server to ship to.
WATCHPOST_AGENT_URL=http://192.168.8.178:8080

# Comma-separated sources to collect. Default and recommended: auth,firewall,web,audit.
#
# Add "syslog" only if you are NOT also collecting auth/firewall. On Debian and Ubuntu,
# rsyslog writes the same sshd and UFW lines into /var/log/syslog as well, so collecting
# both would ingest every matching event twice and detection thresholds would fire at
# half the real count. The agent warns at startup if you do.
WATCHPOST_AGENT_SOURCES=auth,firewall,web,audit

# Where the sources are found. All of them live under this root.
WATCHPOST_AGENT_LOG_DIR=/var/log

# Ingest-only token: create it in Watchpost as an admin (Admin > API tokens) and paste it
# here. It can only ingest; it cannot read data. Must start with wp_.
WATCHPOST_AGENT_TOKEN=

# Extra flags handed to the agent, word-split by systemd.
#
# Plain HTTP to a non-loopback host is refused by default, because the ingest token would
# travel unencrypted. On a trusted LAN you can accept that by uncommenting the next line
# (or better: put HTTPS in front of Watchpost and use an https:// URL above).
#WATCHPOST_AGENT_EXTRA_ARGS=--allow-insecure-http

# Always defined so the unit's $WATCHPOST_AGENT_EXTRA_ARGS expands cleanly when unused.
WATCHPOST_AGENT_EXTRA_ARGS=
